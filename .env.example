# SiteFlow integration configuration
# Copy to .env and chmod 600. Do not commit real values.
# All hosts, IPs and credentials below are documentation placeholders.

# GHCR deployment (root docker-compose.yml). Pin versions for production.
# SITEFLOW_IMAGE_OWNER=hyuan280
# SITEFLOW_API_VERSION=v1.0
# SITEFLOW_WORKER_VERSION=v1.0
# SITEFLOW_WEB_VERSION=v1.0
# SITEFLOW_BITWARDEN_VERSION=v1.0
# SITEFLOW_WEB_PORT=8088


# Required before storing encrypted proxy/token values.
# base64-encoded 32-byte key, e.g. `openssl rand -base64 32`
SITEFLOW_MASTER_KEY=base64:CHANGE_ME

# Optional admin override. If SITEFLOW_ADMIN_PASSWORD is set, these credentials
# are authoritative, are never written to SQLite, and cannot be changed in the UI.
# If unset, SiteFlow uses the database admin (after a password change) or prints
# a random bootstrap password to the startup logs on every restart.
# SITEFLOW_ADMIN_USERNAME=admin
# SITEFLOW_ADMIN_PASSWORD=

# Session absolute lifetime in hours. 168 = 7 days.
# After expiry the admin must log in again. Changing the password also
# invalidates all existing sessions for that admin.
SITEFLOW_SESSION_TTL_HOURS=168

# true only when users access SiteFlow over HTTPS.
# false for local http://localhost:8088 (Secure cookies are not sent over HTTP).
SITEFLOW_COOKIE_SECURE=false

# Login brute-force protection. Both values work together:
# - SITEFLOW_LOGIN_MAX_ATTEMPTS: allowed failed logins per username+IP window
# - SITEFLOW_LOGIN_LOCKOUT_SECONDS: sliding failure window and lock duration
# Example: 5 failures within 300s -> HTTP 429 with Retry-After.
SITEFLOW_LOGIN_MAX_ATTEMPTS=5
SITEFLOW_LOGIN_LOCKOUT_SECONDS=300

# Optional. When set, proxy lanes are enabled and must use this proxy.
# Supported: http://, https://, socks5://, socks5h:// (with optional user:pass@)
# SITEFLOW_PROXY_URL=socks5://user:pass@203.0.113.10:1080

# Optional. Both URL and token are required to enable 2FAuth.
# SITEFLOW_TWOFAUTH_URL=https://2fa.example.com
# SITEFLOW_TWOFAUTH_TOKEN=

# Optional. CFbox screenshot detector. URL is required; API key is optional
# when the CFbox service itself has authentication disabled.
# SITEFLOW_CFBOX_URL=http://cfbox:8000
# SITEFLOW_CFBOX_API_KEY=

# Optional. Bitwarden CLI HTTP wrapper (compose service "bitwarden").
# The wrapper logs in with an API key and unlocks the vault with BW_PASSWORD.
# These values are used by the bitwarden container; SiteFlow ignores them.
# BW_SERVER=https://vault.example.com
# BW_CLIENTID=
# BW_CLIENTSECRET=
# BW_PASSWORD=
# Optional bearer token required by the wrapper's /lookup endpoint.
# BW_API_TOKEN=
# BW_CACHE_SECONDS=60

# Optional SiteFlow overrides for the Bitwarden integration.
# Without overrides SiteFlow auto-detects http://bitwarden:8090 on the compose
# network. The database configuration in Settings takes precedence over
# auto-detection; these environment variables take precedence over the database.
# SITEFLOW_BITWARDEN_URL=http://bitwarden:8090
# SITEFLOW_BITWARDEN_TOKEN=
# SITEFLOW_BITWARDEN_ENABLED=true
# Set to false to disable probing the default compose host entirely.
# SITEFLOW_BITWARDEN_AUTO_DETECT=true
# SITEFLOW_BITWARDEN_TIMEOUT=30
# SITEFLOW_BITWARDEN_PROBE_TIMEOUT=2



# Optional notifications. Run-completion notifications are sent only when the
# channel is enabled in the UI (or *_ENABLED is true and no UI value exists).
# Environment-provided fields are read-only in the UI; the enable switch remains
# editable and stored in the database.
# SITEFLOW_NOTIFICATION_EMAIL_ENABLED=false
# SITEFLOW_NOTIFICATION_EMAIL_SMTP_HOST=smtp.example.com
# SITEFLOW_NOTIFICATION_EMAIL_SMTP_PORT=587
# SITEFLOW_NOTIFICATION_EMAIL_SECURITY=starttls
# SITEFLOW_NOTIFICATION_EMAIL_USERNAME=
# SITEFLOW_NOTIFICATION_EMAIL_PASSWORD=
# SITEFLOW_NOTIFICATION_EMAIL_FROM=siteflow@example.com
# SITEFLOW_NOTIFICATION_EMAIL_TO=admin@example.com,ops@example.com
# SITEFLOW_NOTIFICATION_HTTP_ENABLED=false
# SITEFLOW_NOTIFICATION_HTTP_URL=https://hooks.example.com/siteflow
# SITEFLOW_NOTIFICATION_HTTP_METHOD=POST
# SITEFLOW_NOTIFICATION_HTTP_HEADERS='{"Authorization":"Bearer CHANGE_ME"}'
# SITEFLOW_NOTIFICATION_HTTP_TIMEOUT=10

# Plugin runtime registration. JSON object keyed by plugin id. Each plugin
# must use its own token; do not share one token between plugins.
# JSON object keyed by plugin id. The compose demo uses "demo".
# SITEFLOW_PLUGIN_TOKENS='{"demo":"CHANGE_ME"}'
# Token used by the compose demo plugin. Keep it equal to the demo entry above.
# SITEFLOW_PLUGIN_DEMO_TOKEN=CHANGE_ME
# SITEFLOW_PLUGIN_HEARTBEAT_TTL_SECONDS=90
# Comma-separated exact hosts, host:port entries or CIDR networks allowed for
# plugin endpoints. Docker single-label hostnames are allowed by default.
# SITEFLOW_PLUGIN_ENDPOINT_ALLOWLIST=plugin-demo,plugin-vault,10.20.0.0/16
# SITEFLOW_PLUGIN_VERIFY_ENDPOINT=true
# Resolve plugin hostnames and reject public/loopback/link-local addresses.
# SITEFLOW_PLUGIN_RESOLVE_ENDPOINT=true
# SITEFLOW_PLUGIN_METADATA_TIMEOUT=3

# Internal worker URL. Compose sets this to http://worker:6300.
# SITEFLOW_WORKER_URL=http://worker:6300
# SITEFLOW_ARTIFACT_ROOT=/app/artifacts
# SITEFLOW_ARTIFACT_RETENTION_DAYS=30
# SITEFLOW_ARTIFACT_CLEANUP_INTERVAL_SECONDS=21600
# SITEFLOW_ARTIFACT_CLEANUP_ENABLED=true

# Maximum seconds the API waits for one site job on the worker.
# SITEFLOW_EXECUTION_TIMEOUT=600
# Execution queue limits.
# SITEFLOW_EXECUTION_MAX_RUNS=2
# SITEFLOW_EXECUTION_MAX_JOBS=10
# Per-lane execution concurrency. Interaction lanes are always 1.
# SITEFLOW_LANE_GENERAL_CONCURRENCY=5
# SITEFLOW_LANE_PROXY_GENERAL_CONCURRENCY=3
# Daily scheduler. Sites use checkin_after as the earliest local run time.
# The enable switch and schedule are stored in the database by default.
# Set SITEFLOW_SCHEDULER_ENABLED only to lock the switch via environment.
# SITEFLOW_SCHEDULER_ENABLED=true
# SITEFLOW_SCHEDULER_POLL_SECONDS=30
# SITEFLOW_SCHEDULER_MODE=cron
# SITEFLOW_SCHEDULER_CRON="0 10 * * *"
# SITEFLOW_SCHEDULER_INTERVAL_SECONDS=3600
# SITEFLOW_SCHEDULER_RANGES=08:00-10:00,18:00-20:00
# SITEFLOW_SCHEDULER_TIMEZONE=Asia/Shanghai

# Browser lane idle auto-stop, in seconds. 0 disables it.
# If set, the frontend setting is read-only; otherwise it can be changed in the UI.
# SITEFLOW_LANE_IDLE_STOP_SECONDS=300
# SITEFLOW_PICKER_TTL_SECONDS=900
# Optional OpenAI-compatible vision service (/v1 root). Env overrides encrypted DB settings.
SITEFLOW_VISION_BASE_URL=
SITEFLOW_VISION_API_KEY=
SITEFLOW_VISION_MODEL=
# Set false when the configured model cannot accept image input.
SITEFLOW_VISION_SUPPORTS_VISION=true
SITEFLOW_VISION_TIMEOUT=30
