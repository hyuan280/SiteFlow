# SiteFlow integration configuration
# Copy to .env and chmod 600. Do not commit real values.
# All hosts, IPs and credentials below are documentation placeholders.

# Optional full public URL for notification templates; unset renders an empty string.
# Restart the backend after changing it.
# SITEFLOW_DOMAIN=https://siteflow.example.com

# Required before storing encrypted proxy/token values.
# base64-encoded 32-byte key, e.g. `openssl rand -base64 32`
SITEFLOW_MASTER_KEY=base64:CHANGE_ME

# Required shared secret between the worker and its dedicated browser backend.
# Generate with `openssl rand -hex 32`. Not a CloakBrowser license key.
SITEFLOW_BROWSER_TOKEN=CHANGE_ME
# SITEFLOW_BROWSER_BACKEND=cloak-manager
# SITEFLOW_BROWSER_URL=http://browser:8080
# SITEFLOW_BROWSER_DESKTOP=x11
# Worker-wide finite running-profile cap: integer 1..4, default 1 (never unlimited).
# Free tier is always capped at 1, even when configured higher. Pro/unknown
# capacity has no reliable Manager seat metadata: default conservatively to 1.
# Keyless also defaults to 1. An operator override is not a license entitlement.
# Both Compose files explicitly map this shell/.env input into worker.
SITEFLOW_BROWSER_MAX_ACTIVE_PROFILES=1

# Optional Compose inputs; the default current Manager requires a license key,
# including the free tier. Leaving the key empty does NOT enable keyless mode.
# Nonempty CLOAKBROWSER_LICENSE_KEY locks the SiteFlow BrowserView license card.
# Empty/unset enables saving or explicitly clearing a key through the card in Manager's /data;
# it uses Manager's saved key and hot update, not a duplicate in SiteFlow's DB.
# Clearing removes only Manager's saved setting, not /var/cache/cloakbrowser/license.key;
# both can affect legacy keyless rollback. Never delete the whole cache to clear a key.
# Both Compose files explicitly pass the same shell/.env input to api, worker,
# and browser; API and Worker independently enforce their local ENV locks.
# Adding/changing/removing ENV requires waiting for jobs/viewers to finish,
# then recreating ALL THREE: docker compose up -d --force-recreate api worker browser
# For source deployments add -f ops/docker-compose.yml; restart is not enough.
# Custom external Manager: supply the same key ENV to API, Worker and Manager;
# the provider cannot report ENV provenance, so this is not remote ENV inspection.
# Obtain a key from CloakBrowser; never commit it. Card and uncertain-save recovery:
# docs/browser-backends.md#siteflow-license-card
# CLOAKBROWSER_LICENSE_KEY=
# Pins Manager, not its separately downloaded browser. AUTO_UPDATE=false still
# permits the initial download and license/version checks; browser_cache persists it.
# Compose fixes CLOAKBROWSER_CACHE_DIR=/var/cache/cloakbrowser internally, not a .env knob.
# Reuse the SAME actual named volume and Compose project name when moving its mount
# to /var/cache/cloakbrowser: no cache copy/migration or volume deletion is needed.
# Hidden markers and license.key persist too; cache backups are secret-bearing (0600).
# Remove obsolete overrides mounting /root/.cloakbrowser; leave the bundled path unmounted.
# After jobs/viewers finish, recreate browser to apply the mount/env change; see docs.
# SITEFLOW_BROWSER_IMAGE=cloakhq/cloakbrowser-manager@sha256:d3d9b86cfd94347f7356811cf8222c8bc48152725b053dc6ce2e68f541e00c14
# Leave the binary path empty for the current image to use the custom cache;
# the old bundled path is absent from that image.
# CLOAKBROWSER_BINARY_PATH=
# Legacy keyless rollback only: set BOTH image and path below together.
# Back up browser_data and worker_data/mapping first; downgrades are not guaranteed.
# The explicit legacy path bypasses the cache; its unmounted image path stays visible.
# Saved Manager keys/data and wrapper license.key still need review; never log keys.
# SITEFLOW_BROWSER_IMAGE=cloakhq/cloakbrowser-manager@sha256:04b82e42fe74ec34352580da47b096695e6a8d08745f88e3f5fd821be5ebf989
# CLOAKBROWSER_BINARY_PATH=/root/.cloakbrowser/chromium-146.0.7680.177.5/chrome

# Optional admin override. If SITEFLOW_ADMIN_PASSWORD is set, these credentials
# are authoritative, are never written to SQLite, and cannot be changed in the UI.
# If unset, SiteFlow uses the database admin (after a password change) or prints
# a random bootstrap password to the startup logs on every restart.
# SITEFLOW_ADMIN_USERNAME=admin
# SITEFLOW_ADMIN_PASSWORD=

# Session absolute lifetime in hours. 168 = 7 days.
# After expiry the admin must log in again. Changing the password also
# invalidates all existing sessions for that admin.
SITEFLOW_SESSION_TTL_HOURS=168

# true only when users access SiteFlow over HTTPS.
# false for local http://localhost:8088 (Secure cookies are not sent over HTTP).
SITEFLOW_COOKIE_SECURE=false

# Login brute-force protection. Both values work together:
# - SITEFLOW_LOGIN_MAX_ATTEMPTS: allowed failed logins per username+IP window
# - SITEFLOW_LOGIN_LOCKOUT_SECONDS: sliding failure window and lock duration
# Example: 5 failures within 300s -> HTTP 429 with Retry-After.
SITEFLOW_LOGIN_MAX_ATTEMPTS=5
SITEFLOW_LOGIN_LOCKOUT_SECONDS=300

# Optional. When set, proxy lanes are enabled and must use this proxy.
# Supported: http://, https://, socks5://, socks5h:// (with optional user:pass@)
# SITEFLOW_PROXY_URL=socks5://user:pass@203.0.113.10:1080

# Optional. Both URL and token are required to enable 2FAuth.
# SITEFLOW_TWOFAUTH_URL=https://2fa.example.com
# SITEFLOW_TWOFAUTH_TOKEN=

# Optional, disabled by default: assistant and text-only AI configuration generation.
# Selects registry usage "assistant"; the single-request generator never saves or runs.
# Assistant execution/import/full runs still require their separate host permissions.
# SITEFLOW_CONFIG_AI_ENABLED=false

# Optional. CFbox screenshot detector (compose service "cfbox").
# URL is required; API key is optional when CFbox authentication is disabled.
SITEFLOW_CFBOX_URL=http://cfbox:8000
# SITEFLOW_CFBOX_API_KEY=
# CFBOX_IDLE_UNLOAD_SECONDS=300
# CFBOX_LOAD_ON_STARTUP=true

# Optional. Bitwarden CLI HTTP wrapper (compose service "bitwarden").
# The wrapper logs in with an API key and unlocks the vault with BW_PASSWORD.
# These values are used by the bitwarden container; SiteFlow ignores them.
# BW_SERVER=https://vault.example.com
# BW_CLIENTID=
# BW_CLIENTSECRET=
# BW_PASSWORD=
# Optional bearer token required by the wrapper's /lookup endpoint.
# BW_API_TOKEN=
# BW_CACHE_SECONDS=60

# Optional SiteFlow overrides for the Bitwarden integration.
# Without overrides SiteFlow auto-detects http://bitwarden:8090 on the compose
# network. The database configuration in Settings takes precedence over
# auto-detection; these environment variables take precedence over the database.
# SITEFLOW_BITWARDEN_URL=http://bitwarden:8090
# SITEFLOW_BITWARDEN_TOKEN=
# SITEFLOW_BITWARDEN_ENABLED=true
# Set to false to disable probing the default compose host entirely.
# SITEFLOW_BITWARDEN_AUTO_DETECT=true
# SITEFLOW_BITWARDEN_TIMEOUT=30
# SITEFLOW_BITWARDEN_PROBE_TIMEOUT=2



# Optional notifications. Run-completion notifications are sent only when the
# channel is enabled in the UI (or *_ENABLED is true and no UI value exists).
# Environment-provided fields are read-only in the UI; the enable switch remains
# editable and stored in the database.
# SITEFLOW_NOTIFICATION_EMAIL_ENABLED=false
# SITEFLOW_NOTIFICATION_EMAIL_SMTP_HOST=smtp.example.com
# SITEFLOW_NOTIFICATION_EMAIL_SMTP_PORT=587
# SITEFLOW_NOTIFICATION_EMAIL_SECURITY=starttls
# SITEFLOW_NOTIFICATION_EMAIL_USERNAME=
# SITEFLOW_NOTIFICATION_EMAIL_PASSWORD=
# SITEFLOW_NOTIFICATION_EMAIL_FROM=siteflow@example.com
# SITEFLOW_NOTIFICATION_EMAIL_TO=admin@example.com,ops@example.com
# SITEFLOW_NOTIFICATION_HTTP_ENABLED=false
# SITEFLOW_NOTIFICATION_HTTP_URL=https://hooks.example.com/siteflow
# SITEFLOW_NOTIFICATION_HTTP_METHOD=POST
# SITEFLOW_NOTIFICATION_HTTP_HEADERS='{"Authorization":"Bearer CHANGE_ME"}'
# SITEFLOW_NOTIFICATION_HTTP_TIMEOUT=10

# Plugin runtime registration. JSON object keyed by plugin id. Each plugin
# must use its own token; do not share one token between plugins.
# JSON object keyed by plugin id. The compose demo uses "demo".
# SITEFLOW_PLUGIN_TOKENS='{"demo":"CHANGE_ME"}'
# Token used by the compose demo plugin. Keep it equal to the demo entry above.
# SITEFLOW_PLUGIN_DEMO_TOKEN=CHANGE_ME
# SITEFLOW_PLUGIN_HEARTBEAT_TTL_SECONDS=90
# Comma-separated exact hosts, host:port entries or CIDR networks allowed for
# plugin endpoints. Docker single-label hostnames are allowed by default.
# SITEFLOW_PLUGIN_ENDPOINT_ALLOWLIST=plugin-demo,plugin-vault,10.20.0.0/16
# SITEFLOW_PLUGIN_VERIFY_ENDPOINT=true
# Resolve plugin hostnames and reject public/loopback/link-local addresses.
# SITEFLOW_PLUGIN_RESOLVE_ENDPOINT=true
# SITEFLOW_PLUGIN_METADATA_TIMEOUT=3

# Internal worker URL. Compose sets this to http://worker:6300.
# SITEFLOW_WORKER_URL=http://worker:6300
# SITEFLOW_ARTIFACT_ROOT=/app/artifacts
# SITEFLOW_ARTIFACT_RETENTION_DAYS=30
# SITEFLOW_ARTIFACT_CLEANUP_INTERVAL_SECONDS=21600
# SITEFLOW_ARTIFACT_CLEANUP_ENABLED=true

# Maximum seconds the API waits for one site job on the worker.
# SITEFLOW_EXECUTION_TIMEOUT=600
# Execution queue limits.
# SITEFLOW_EXECUTION_MAX_RUNS=2
# SITEFLOW_EXECUTION_MAX_JOBS=10
# All initially nonempty Run lanes register together for Worker dispatch.
# Non-preemptive priority: general, interaction, proxy_general, proxy_interaction.
# Only granted reservations create execution tasks and compete for global job slots;
# pending tickets occupy no global job slots. Effective cap 2 allows two lanes of
# one Run to overlap; free cap 1 keeps different lanes sequential. Other runs,
# assistants and viewers share the same finite profile pool.
# Shared per-lane task limits: general defaults to 5, proxy general to 3, each
# configurable 1..10; interaction is fixed at 1. The short input lock is unchanged.
# SITEFLOW_LANE_GENERAL_CONCURRENCY=5
# SITEFLOW_LANE_PROXY_GENERAL_CONCURRENCY=3
# Daily scheduler. Sites use checkin_after as the earliest local run time.
# The enable switch and schedule are stored in the database by default.
# Set SITEFLOW_SCHEDULER_ENABLED only to lock the switch via environment.
# SITEFLOW_SCHEDULER_ENABLED=true
# SITEFLOW_SCHEDULER_POLL_SECONDS=30
# SITEFLOW_SCHEDULER_MODE=cron
# SITEFLOW_SCHEDULER_CRON="0 10 * * *"
# SITEFLOW_SCHEDULER_INTERVAL_SECONDS=3600
# SITEFLOW_SCHEDULER_RANGES=08:00-10:00,18:00-20:00
# SITEFLOW_SCHEDULER_TIMEZONE=Asia/Shanghai

# Browser lane idle auto-stop, in seconds. 0 disables the timer, not pressure stop.
# The finite profile queue can immediately stop an idle SiteFlow-owned profile
# to admit another lane, preserving its ID/cookies. Active leases, viewers,
# task pages and quarantined ownership prevent this; an open viewer pins it.
# If set, the frontend setting is read-only; otherwise it can be changed in the UI.
# SITEFLOW_LANE_IDLE_STOP_SECONDS=300
# SITEFLOW_PICKER_TTL_SECONDS=900

# Optional: one environment-configured OpenAI-compatible model in the ordered list.
# Supply the /v1 API root, API key and upstream model name; blank strings are unset.
# Any of these five model settings (including false/0) makes the whole connection
# read-only and non-deletable in Settings (ENV tag); order/enable/usages stay editable.
# An incomplete ENV row must be fixed in deployment settings, not in the UI.
# Old SITEFLOW_VISION_* names are ignored, with no alias fallback.
# Rename deployment variables to SITEFLOW_MODEL_*.
SITEFLOW_MODEL_BASE_URL=
SITEFLOW_MODEL_API_KEY=
SITEFLOW_MODEL_ID=
# Set this only when an ENV model is desired; false means text-only.
# Omission uses the saved DB flag, defaulting to true; without an ENV model it is UI-editable.
# SITEFLOW_MODEL_SUPPORTS_VISION=true
# Optional output-token limit (nonnegative integer). 4096 sends max_tokens=4096;
# 0 omits max_tokens and uses provider defaults, NOT guaranteed unlimited output.
# Leave commented (not empty) to retain the saved DB cap; an empty value becomes 0.
# To clear a DB cap in the UI, first remove all ENV model settings, then use blank/0.
# Assistant null inherits its selected model's cap; an explicit assistant cap overrides it.
# Thinking models also need budget for the final answer. No automatic model switching.
# SITEFLOW_MODEL_MAX_TOKENS=4096
# SITEFLOW_MODEL_MAX_TOKENS=0
# Global model request timeout in seconds (all models, default 30, maximum 300).
# Timeout alone does not create or lock an ENV row; browser-direct tests use 30 seconds.
SITEFLOW_MODEL_TIMEOUT=30

# GHCR deployment (root docker-compose.yml). Pin versions for production.
# SITEFLOW_IMAGE_OWNER=hyuan280
# SITEFLOW_API_VERSION=v1.0
# SITEFLOW_WORKER_VERSION=v1.0
# SITEFLOW_WEB_VERSION=v1.0
# SITEFLOW_BITWARDEN_VERSION=v1.0
# SITEFLOW_CFBOX_VERSION=latest
# SITEFLOW_WEB_PORT=8088

# Optional Docker resource monitoring; requires a supporting API image and the
# "show system resources" UI switch. See docs/system-resources.md for security.
# The main Compose file does NOT mount the socket. Opt in with:
# docker compose -f docker-compose.yml -f docker-compose.resources.yml up -d
# A :ro socket mount does NOT prevent Docker API writes (root-equivalent access
# with a rootful daemon). Project label filtering is NOT security isolation.
# Backend defaults (also for deployments outside Compose):
# SITEFLOW_DOCKER_SOCKET=/var/run/docker.sock
# SITEFLOW_DOCKER_PROJECT=siteflow
# Root Compose explicitly sets SITEFLOW_DOCKER_PROJECT from COMPOSE_PROJECT_NAME,
# defaulting to its top-level name: siteflow. Set COMPOSE_PROJECT_NAME explicitly
# for a custom project; if using -p, set it to the SAME value, never a new name
# for an existing deployment. SITEFLOW_DOCKER_PROJECT in .env cannot override
# the root Compose environment mapping.
# COMPOSE_PROJECT_NAME=siteflow
# Optional host-side socket path only (e.g. /run/user/1000/docker.sock for rootless).
# Keep the backend/container path above at /var/run/docker.sock with this override.
# SITEFLOW_DOCKER_SOCKET_HOST=/var/run/docker.sock
