FROM python:3.12-slim-bookworm

ARG PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
COPY ops/debian.sources /etc/apt/sources.list.d/debian.sources
# X11 client tools only. The browser and display server live in an external backend.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates xdotool libxrandr2 \
    && rm -rf /var/lib/apt/lists/*

ENV SITEFLOW_WORKER_DATA=/app/data \
    PYTHONUNBUFFERED=1
WORKDIR /app
COPY worker/requirements.txt /app/worker-requirements.txt
RUN pip install --no-cache-dir -i "$PIP_INDEX_URL" -r /app/worker-requirements.txt
COPY LICENSE THIRD_PARTY_NOTICES.md /usr/share/doc/siteflow/
COPY worker /app/worker
COPY proto/siteflow_proto /app/siteflow_proto
EXPOSE 6300
HEALTHCHECK --interval=10s --timeout=3s --start-period=30s --retries=5 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:6300/health', timeout=2)"
ENTRYPOINT ["uvicorn", "worker.app:create_app", "--factory", "--host", "0.0.0.0", "--port", "6300"]
